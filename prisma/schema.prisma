
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}



model Personagem {
  id         Int    @id @default(autoincrement())
  nome       String
  idade      Int
  posicao    String
  habilidade String
}

model Funcionario {
  id        Int    @id @default(autoincrement())
  nome      String
  senha     String
  cpf       String @unique
  email     String @unique
  cargo     String

}
